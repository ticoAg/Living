{
  "name": "living",
  "version": "0.1.0",
  "description": "Living：旅行与生活的影像图库，部署在 Cloudflare Workers。",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run typecheck && vite build",
    "db:migrate:local": "wrangler d1 migrations apply living --local",
    "db:migrate:remote": "wrangler d1 migrations apply living --remote",
    "deploy": "wrangler d1 migrations apply living --remote && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ticoAg/Living.git"
  },
  "bugs": {
    "url": "https://github.com/ticoAg/Living/issues"
  },
  "homepage": "https://github.com/ticoAg/Living#readme",
  "dependencies": {
    "exifr": "^7.1.3",
    "hono": "^4.13.17",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^1.9.0",
    "thumbhash": "^0.1.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
