{
  "name": "living",
  "version": "0.1.0",
  "private": true,
  "description": "Living：旅行与生活的影像图库，部署在 Cloudflare Workers。",
  "homepage": "https://github.com/ticoAg/Living#readme",
  "bugs": {
    "url": "https://github.com/ticoAg/Living/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ticoAg/Living.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "test": "vp test",
    "build": "vp check --no-fmt && vp test && vp build",
    "db:migrate:local": "wrangler d1 migrations apply living --local",
    "db:migrate:remote": "wrangler d1 migrations apply living --remote",
    "deploy": "npm run build && wrangler d1 migrations apply living --remote && wrangler deploy"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "hono": "^4.13.17",
    "libheif-js": "^1.23.5",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^1.9.0",
    "thumbhash": "^0.1.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
