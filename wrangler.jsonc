{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "living",
  "main": "worker/index.ts",
  "account_id": "6f12e69d95b961f8dcfc1fa867859b75",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The SPA is served from static assets; the Worker only runs first for the API and media.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Paths are app routes, not file names: without this, /index is redirected to / (it names index.html).
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living",
      "database_id": "4024f786-2178-4cb7-ac52-040715a2798b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "living-photos" }],
  "kv_namespaces": [{ "binding": "KV", "id": "37fae53ace6d479380c48980477aa176" }],
  // A Worker route, not a custom domain: the DNS record for living.ticoag.fun is managed by hand in the zone.
  "routes": [{ "pattern": "living.ticoag.fun/*", "zone_id": "c823bc358d7a051de8df8cb19c6d2736" }],
  // Hourly: fill in the province (and a missing city or district) of photos stored without one (worker/lib/regions.ts).
  "triggers": { "crons": ["23 * * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "SITE_NAME": "Living", "SITE_URL": "https://living.ticoag.fun" }
}
